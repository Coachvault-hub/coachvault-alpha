          "name": "Use the body as a shield",
          "observableBehaviors": [
            "Shoulder and hip separate defender from stick",
            "Player stays balanced"
          ],
          "coachingCues": [
            "Body first",
            "Own the space"
          ],
          "commonMistakes": [
            "Stick exposed",
            "Turning back without balance"
          ],
          "corrections": [
            "Move feet to pressure",
            "Keep body between defender and stick"
          ],
          "progressions": [
            "Shadow pressure",
            "Guided contact",
            "Live pressure"
          ]
        }
      ]
    },
    {
