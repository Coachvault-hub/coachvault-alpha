          "observableBehaviors": [
            "Top hand controls direction",
            "Bottom hand supports leverage"
          ],
          "coachingCues": [
            "Hands apart",
            "Top hand leads"
          ],
          "commonMistakes": [
            "Hands together",
            "Bottom-hand dominant"
          ],
          "corrections": [
            "Separate hands",
            "Lead with top hand"
          ],
          "progressions": [
            "Stationary mechanics",
            "Short passing",
            "On move"
          ]
        }
      ]
    },
